# Configurações do Bot
BOT_NAME="ZapBot"
BOT_PREFIX="!"

# Chave da API do Google Gemini (obtenha gratuitamente em https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Moderação de Grupo
ANTI_LINK=true

# Boas-vindas e Regras
WELCOME_ENABLED=true
WELCOME_MESSAGE="👋 Olá @user! Seja muito bem-vindo(a) ao grupo *{group_name}*!\n\n📌 Digite *!regras* para ver as normas do grupo ou *!menu* para conhecer meus comandos."
GROUP_RULES="📜 *Regras do Grupo:*\n1. Respeite todos os participantes.\n2. Proibido spam ou envio de links não autorizados.\n3. Mantenha as mensagens dentro do tema do grupo.\n4. Evite discussões desrespeitosas."

# Notificações Agendadas (Exemplo: todos os dias às 09:00 da manhã)
SCHEDULE_ENABLED=false
SCHEDULE_CRON="0 9 * * *"
# Se deixar vazio, enviará para todos os grupos onde o bot está presente
SCHEDULE_TARGET_GROUP=""
SCHEDULE_MESSAGE="☀️ *Bom dia, pessoal!* Desejamos um ótimo dia a todos no grupo! Lembrem-se das nossas regras e aproveitem o dia."
